<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        GameStudio Engine palette — the XFS Studio identity (near-black base, Punisher red accent,
        skull mark) carried over, with an added elevation scale so panels, cards and popovers read
        as distinct layers instead of one flat sheet.
    -->

    <!-- Surfaces, darkest to lightest -->
    <Color x:Key="Surface0">#08080A</Color>
    <Color x:Key="Surface1">#0E0E11</Color>
    <Color x:Key="Surface2">#131316</Color>
    <Color x:Key="Surface3">#1B1B20</Color>
    <Color x:Key="Surface4">#232329</Color>
    <Color x:Key="Overlay">#CC08080A</Color>

    <!-- Lines -->
    <Color x:Key="Border">#29292F</Color>
    <Color x:Key="BorderStrong">#3A3A43</Color>
    <Color x:Key="BorderFocus">#FF5A50</Color>

    <!-- Brand -->
    <Color x:Key="Accent">#E4241B</Color>
    <Color x:Key="AccentHover">#FF3B30</Color>
    <Color x:Key="AccentPressed">#B81B14</Color>
    <Color x:Key="AccentSubtle">#3A0E0C</Color>

    <!-- Text -->
    <Color x:Key="TextPrimary">#F2F2F4</Color>
    <Color x:Key="TextSecondary">#A9A9B4</Color>
    <Color x:Key="TextMuted">#6C6C78</Color>

    <!-- Semantic -->
    <Color x:Key="Success">#35D48C</Color>
    <Color x:Key="Warning">#F5A623</Color>
    <Color x:Key="Danger">#FF3B30</Color>
    <Color x:Key="Info">#4DA3FF</Color>

    <SolidColorBrush x:Key="Surface0Brush" Color="{StaticResource Surface0}"/>
    <SolidColorBrush x:Key="Surface1Brush" Color="{StaticResource Surface1}"/>
    <SolidColorBrush x:Key="Surface2Brush" Color="{StaticResource Surface2}"/>
    <SolidColorBrush x:Key="Surface3Brush" Color="{StaticResource Surface3}"/>
    <SolidColorBrush x:Key="Surface4Brush" Color="{StaticResource Surface4}"/>
    <SolidColorBrush x:Key="OverlayBrush" Color="{StaticResource Overlay}"/>

    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource Border}"/>
    <SolidColorBrush x:Key="BorderStrongBrush" Color="{StaticResource BorderStrong}"/>
    <SolidColorBrush x:Key="BorderFocusBrush" Color="{StaticResource BorderFocus}"/>

    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource Accent}"/>
    <SolidColorBrush x:Key="AccentHoverBrush" Color="{StaticResource AccentHover}"/>
    <SolidColorBrush x:Key="AccentPressedBrush" Color="{StaticResource AccentPressed}"/>
    <SolidColorBrush x:Key="AccentSubtleBrush" Color="{StaticResource AccentSubtle}"/>

    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimary}"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondary}"/>
    <SolidColorBrush x:Key="TextMutedBrush" Color="{StaticResource TextMuted}"/>

    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource Success}"/>
    <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource Warning}"/>
    <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource Danger}"/>
    <SolidColorBrush x:Key="InfoBrush" Color="{StaticResource Info}"/>

    <LinearGradientBrush x:Key="AccentGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FF3B30" Offset="0"/>
        <GradientStop Color="#E4241B" Offset="1"/>
    </LinearGradientBrush>

    <!-- Sits behind the toolbar: a faint red bloom so the chrome doesn't read as a flat black bar. -->
    <LinearGradientBrush x:Key="ChromeGradientBrush" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#16090A" Offset="0"/>
        <GradientStop Color="#131316" Offset="0.45"/>
        <GradientStop Color="#131316" Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="CardGradientBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#17171B" Offset="0"/>
        <GradientStop Color="#121215" Offset="1"/>
    </LinearGradientBrush>

    <!-- Skull mark, shared with XFS Studio so the two tools read as one family. -->
    <LinearGradientBrush x:Key="PunisherLogoGradient" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#FF5A76" Offset="0"/>
        <GradientStop Color="#B81733" Offset="1"/>
    </LinearGradientBrush>
    <Geometry x:Key="PunisherLogoSilhouette">
        M50 6 C64 6 76 12 82 24 C87 34 86 44 80 51 C76 56 71 55 68 60 L69 63
        C73 63 76 68 74 73 C72 78 67 79 65 75 C63 71 63 66 60 64
        C58 68 58 74 56 80 C55 84 51 84 50 80 C50 74 51 68 51 64
        C51 68 50 74 50 80 C49 84 45 84 44 80 C42 74 42 68 40 64
        C37 66 37 71 35 75 C33 79 28 78 26 73 C24 68 27 63 31 63 L32 60
        C29 55 24 56 20 51 C14 44 13 34 18 24 C24 12 36 6 50 6 Z
    </Geometry>
    <Geometry x:Key="PunisherLogoBrowL">M22 27 C29 21 38 19 45 21 C38 22 30 25 24 31 Z</Geometry>
    <Geometry x:Key="PunisherLogoBrowR">M78 27 C71 21 62 19 55 21 C62 22 70 25 76 31 Z</Geometry>
    <Geometry x:Key="PunisherLogoEyeL">M23 30 C22 26 27 21 34 22 C42 23 46 32 44 40 C42 47 34 49 28 44 C23 40 24 34 23 30 Z</Geometry>
    <Geometry x:Key="PunisherLogoEyeR">M77 30 C78 26 73 21 66 22 C58 23 54 32 56 40 C58 47 66 49 72 44 C77 40 76 34 77 30 Z</Geometry>
    <Geometry x:Key="PunisherLogoNose">M50 42 L45 51 L50 55 L55 51 Z</Geometry>
    <Geometry x:Key="PunisherLogoFangL">M32 62 L38 61 L36 80 L31 77 Z</Geometry>
    <Geometry x:Key="PunisherLogoFangM">M45 63 L55 63 L52 88 L48 88 Z</Geometry>
    <Geometry x:Key="PunisherLogoFangR">M62 61 L68 62 L69 77 L64 80 Z</Geometry>

    <!-- Effects -->
    <DropShadowEffect x:Key="SoftShadow" BlurRadius="18" ShadowDepth="3" Direction="270" Color="#000000" Opacity="0.55"/>
    <DropShadowEffect x:Key="AccentGlow" BlurRadius="22" ShadowDepth="0" Color="#E4241B" Opacity="0.55"/>
    <DropShadowEffect x:Key="AccentGlowSoft" BlurRadius="14" ShadowDepth="0" Color="#E4241B" Opacity="0.30"/>

    <!-- Metrics -->
    <CornerRadius x:Key="RadiusSm">4</CornerRadius>
    <CornerRadius x:Key="RadiusMd">7</CornerRadius>
    <CornerRadius x:Key="RadiusLg">11</CornerRadius>

</ResourceDictionary>
